# Keep the build context to what the Dockerfile needs. A host node_modules
# (e.g. Windows-built node-sass) must never overwrite the image's `npm ci` output.
node_modules
build
coverage
.git
.github
npm-debug.log*
.DS_Store
# Developer-local env files (gitignored) must not leak into the image.
.env
.env.local
.env.*.local
